{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra Content Hub V1 page",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendedVersion": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "thumbnail": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16777216
                  }
                },
                "required": [
                  "url",
                  "sha256",
                  "bytes"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "manifestUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "displayName",
          "description",
          "category",
          "tags",
          "recommendedVersion",
          "compressedBytes",
          "manifestUrl",
          "manifestSha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    }
  },
  "required": [
    "schemaVersion",
    "packs"
  ],
  "additionalProperties": false
}
