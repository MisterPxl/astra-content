{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra Content Hub V2 catalog",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "indexUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "indexSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "indexUrl",
    "indexSha256"
  ],
  "additionalProperties": false
}
